# ==============================================================================
# ClaimCheck AI Environment Configuration
# ==============================================================================

# Backend Configuration
ENVIRONMENT=development
APP_NAME=ClaimCheck AI
APP_VERSION=1.0.0

# Optional LLM Integration (OpenAI or OpenAI-compatible endpoint)
# If left empty, ClaimCheck AI automatically runs its robust deterministic NLI engine
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Verification & Retrieval Settings
MAX_UPLOAD_SIZE_BYTES=15728640
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=35
MAX_RETRIEVED_PASSAGES_PER_CLAIM=3
RELEVANCE_THRESHOLD=0.15

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
