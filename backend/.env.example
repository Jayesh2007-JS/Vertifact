# Vertifact - Backend Environment Configuration

# OpenAI API Key (or OpenAI-compatible key from Groq, OpenRouter, Ollama)
# Get your OpenAI API key from: https://platform.openai.com/api-keys
# Or free Groq API key from: https://console.groq.com/keys
OPENAI_API_KEY=

# LLM Model Name
# Default: gpt-4o-mini (Fast, cheap, and highly capable)
# Other options: gpt-4o, llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# Optional Custom Base URL (Leave commented out for standard OpenAI)
# For Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# For OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# For Ollama (Local):
# OPENAI_BASE_URL=http://localhost:11434/v1
